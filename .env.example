# Environment Variables for CDK Deployment
# Copy this file to .env and fill in your values
# Then run: source .env

# Required: Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
export GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: OpenAI API Key (for Audio Quality Audit)
# Get your key from: https://platform.openai.com/api-keys
# Used by audit-lambda to transcribe audio with Whisper API ($0.006/minute)
export OPENAI_API_KEY="your-openai-api-key-here"

# Optional: AWS Configuration (defaults shown)
export CDK_DEFAULT_ACCOUNT="272765753210"
export CDK_DEFAULT_REGION="us-east-1"
